[flake8]
max-line-length = 120
ignore =
# Missing docstring in public module
    D100,
# Missing docstring in public package
    D104,
# One-line docstring should fit on one line with quotes
    D200,
# No blank lines allowed after function docstring
    D202,
# 1 blank line required between summary line and description
    D205,
# Use """triple double quotes"""
    D300,
# First line should end with a period
    D400,
# First line should be in imperative mood
    D401,
# Line break occurred before a binary operator
    W503,
# Trailing whitespace
    W291,
# Annotation for self
    ANN101,
# Missing type annotation for *args
    ANN002,
# Missing type annotation for *kwargs
    ANN003,
# Your import statements are in the wrong order.
    I100,
# The names in your from import are in the wrong order.
    I101,
# Missing newline between import groups.
    I201,
# Additional newline in a group of imports.
    I202,
strict-parameters = True
docstring-convention = numpy
inline-quotes = single
multiline-quotes = single
flake8-docstring-quotes = single
docstring-quotes = single
exclude =
    .git
    .vscode
    env
    __pycache__
    requirements.txt
avoid-escape = False
per-file-ignores =
# imported but unused
    __init__.py:F401